*.swp
*.swo
*~
.project
.classpath
.settings/
.c9/
*.launch
.history/
.ionide/

# -----------------------------------------------------------------------------
# Cursor — allow shared rules; ignore other local Cursor state
# -----------------------------------------------------------------------------
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# -----------------------------------------------------------------------------
# SpecStory — ignore tool-local state; allow committing history/
# -----------------------------------------------------------------------------
.specstory/*
!.specstory/history/
!.specstory/history/**
.cursorindexingignore

# -----------------------------------------------------------------------------
# graphify — regenerable knowledge graph + machine-local paths
# -----------------------------------------------------------------------------
graphify-out/
.graphify/

# -----------------------------------------------------------------------------
# Local / developer / scratch / agent tool state (not shared)
# -----------------------------------------------------------------------------
*.local
*.local.*
local/
.local/
scratch/
tmp/
temp/
.tmp/
.temp/
.private/
private/
personal/
.user/
user-data/
.cache/
*.bak
*.tmp
*.temp
*.stackdump

# Archives / packages produced locally (prefer CI artifacts)
*.zip
*.tar.gz
*.rar
*.7z

# AI / agent tool caches at repo root
.agent-transcripts/
.claude/
.codex/
.continue/
.aider*
.copilot/
.windsurf/
.gemini/
.anthropic/

# Python sidecars (graphify / local scripts)
__pycache__/
*.py[cod]
.venv/
venv/
.Python
