# =============================================================================
# ticket-management — project .gitignore
# Stack: Java 21, Spring Boot 3, React, Node.js, Docker, PostgreSQL / PgVector
# Tools: IntelliJ IDEA, Cursor, SpecStory, graphify, macOS
# =============================================================================

# -----------------------------------------------------------------------------
# OS — macOS (and common Windows noise)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Secrets, credentials, local env (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.p12
*.jks
*.keystore
*.key
!*.pub
secrets/
credentials/
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/application-*.local.yml
**/application-*.local.yaml
**/application-*.local.properties

# -----------------------------------------------------------------------------
# Java / Spring Boot (Maven & Gradle)
# Keep the Maven/Gradle wrapper scripts + properties in git; do not ignore them.
# -----------------------------------------------------------------------------
target/
build/
out/
bin/
.gradle/
.mvn/timing.properties

*.class
*.jar
*.war
*.ear
*.nar
!**/gradle-wrapper.jar
!**/maven-wrapper.jar
hs_err_pid*
replay_pid*
*.orig

# Spring Boot DevTools / local runtime
spring-boot-devtools.properties
.restart/
.springBeans
.factorypath

# -----------------------------------------------------------------------------
# Node.js / React
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnpm-store/

dist/
.next/
.nuxt/
.out/
.vercel/
.netlify/
*.tsbuildinfo
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache

# Logs & coverage
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.nyc_output/
*.lcov
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test / tooling caches
.jest/
.vitest/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

